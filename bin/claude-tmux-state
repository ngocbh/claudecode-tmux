#!/bin/sh
# claude-tmux-state — record this Claude Code pane's state, used two ways:
#   1. the cross-session status-right chip (see claude-tmux-status), and
#   2. tinting the tmux WINDOW tab the Claude lives in (orange=running,
#      red=asking, default=idle).
#
# Usage: claude-tmux-state <running|asking|idle|clear> [--attention]
#   --attention bypasses idle-notification filtering for explicit Codex prompts.
#   Wired to Claude Code hooks (SessionStart/UserPromptSubmit/PostToolUse ->
#   running, Notification -> asking, Stop -> idle, SessionEnd -> clear).
#   Note: a Notification fires both for a genuine prompt AND for the 60s
#   "waiting for your input" idle timeout; the latter is filtered out below so a
#   finished, unattended session doesn't falsely turn red (see "asking" guard).
#
# Keyed by tmux pane id ($TMUX_PANE). State file format: "<state>\t<window_id>"
# — the window id lets claude-tmux-status re-tint the right window even after the
# pane has died. No-op outside tmux.

[ -n "$TMUX" ] && [ -n "$TMUX_PANE" ] || exit 0

# The tmux server supplies its identity, including through an SSH-forwarded
# socket. Separate servers can reuse pane IDs while sharing the same home.
server=$(tmux display-message -p '#{host}-#{pid}' 2>/dev/null) || exit 0
case "$server" in ''|*[!a-zA-Z0-9_.-]*) exit 0 ;; esac
dir="$HOME/.cache/claude-tmux/$server"

# ---- tunables (override in ~/.config/claude-tmux/config) --------------------
CT_RUN_TAB='fg=#1a1b26,bg=#ff9e64,bold'   # window-tab tint: working
CT_ASK_TAB='fg=#1a1b26,bg=#f7768e,bold'   # window-tab tint: needs input
_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/claude-tmux/config"
[ -r "$_cfg" ] && . "$_cfg"
# ----------------------------------------------------------------------------

id=$(printf '%s' "$TMUX_PANE" | tr -d '%')
f="$dir/pane-$id"
state="$1"

# --- 0. drop the idle-timeout Notification (false "asking") ------------------
# Claude Code fires Notification both for a genuine attention prompt (permission
# / question) AND for the 60s "waiting for your input" idle timeout. Only the
# former should turn the tab red. Treat a Notification as the idle timeout — and
# no-op — when either:
#   (a) the hook payload on stdin says it's just waiting for input, or
#   (b) the pane is already idle: a stopped Claude isn't running anything, so it
#       cannot be genuinely blocked on you — the notification must be the timer.
# (a) is best-effort (message wording may change); (b) is the reliable net.
if [ "$state" = "asking" ] && [ "${2:-}" != --attention ]; then
  _msg=""
  [ -t 0 ] || _msg=$(cat 2>/dev/null)
  case "$_msg" in *[Ww]aiting?for?your?input*) exit 0 ;; esac
  [ "$(cut -f1 "$f" 2>/dev/null)" = idle ] && exit 0
fi

# --- 1. update the per-pane state file ---------------------------------------
if [ "$state" = "clear" ]; then
  rm -f "$f"
else
  mkdir -p "$dir"
  # Skip the rest when the state word is unchanged (PostToolUse fires on every
  # tool); the file + window tint already reflect it.
  [ -f "$f" ] && [ "$(cut -f1 "$f" 2>/dev/null)" = "$state" ] && exit 0
fi

win=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null)
[ "$state" = "clear" ] || printf '%s\t%s\n' "$state" "$win" >"$f"

# --- 2. tint the window tab from the aggregate of its Claude panes -----------
# Priority asking > running > idle. Set both styles because tmux uses
# window-status-style for inactive tabs and window-status-current-style for the
# active tab.
if [ -n "$win" ]; then
  agg=idle
  for pid in $(tmux list-panes -t "$win" -F '#{pane_id}' 2>/dev/null | tr -d '%'); do
    s=$(cut -f1 "$dir/pane-$pid" 2>/dev/null)
    if [ "$s" = asking ]; then
      agg=asking
      break
    fi
    [ "$s" = running ] && agg=running
  done
  case "$agg" in
    asking)
      tmux set-option -w -t "$win" window-status-style "$CT_ASK_TAB" 2>/dev/null
      tmux set-option -w -t "$win" window-status-current-style "$CT_ASK_TAB" 2>/dev/null ;;
    running)
      tmux set-option -w -t "$win" window-status-style "$CT_RUN_TAB" 2>/dev/null
      tmux set-option -w -t "$win" window-status-current-style "$CT_RUN_TAB" 2>/dev/null ;;
    *)
      tmux set-option -wu -t "$win" window-status-style 2>/dev/null
      tmux set-option -wu -t "$win" window-status-current-style 2>/dev/null ;;
  esac
fi

# Immediate status-line redraw so the chip updates without waiting for
# status-interval.
tmux refresh-client -S 2>/dev/null
exit 0
