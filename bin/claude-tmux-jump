#!/bin/sh
# claude-tmux-jump — jump to the session/window of a clicked status chip.
#
# Bound (indirectly) to MouseDown1Status via claude-tmux-click.tmux, but only for
# clicks whose range is one of our chips: an if-shell guard calls this with
#   $1 = #{mouse_status_range}  (e.g. "ct@5" — the chip's "ct<window_id>" tag)
#   $2 = #{client_name}         (the client that clicked; optional)
# claude-tmux-status produces the tag by wrapping each chip in
# "#[range=user|ct<window_id>]…#[norange]".
#
# We resolve the window id back to its session and switch the clicking client there,
# then select the window. Using the globally-unique window id (rather than a
# "session:window" string) sidesteps fragility with colons in session names or
# windows that have since been renamed/renumbered. No-op outside tmux or on a tag
# that isn't ours (the guard should prevent the latter, but stay defensive).

[ -n "$TMUX" ] || exit 0

r="${1:-}"
client="${2:-}"
case "$r" in
  ct@*) w=${r#ct} ;;   # strip the "ct" tag -> a tmux window id like "@5"
  *) exit 0 ;;          # not ours: nothing to do
esac

# Window ids are unique server-wide, so this resolves the right session even
# though the click came from a different one.
sess=$(tmux display-message -p -t "$w" '#{session_name}' 2>/dev/null)
[ -n "$sess" ] || exit 0
if [ -n "$client" ]; then
  tmux switch-client -c "$client" -t "$sess" 2>/dev/null
else
  tmux switch-client -t "$sess" 2>/dev/null
fi
tmux select-window -t "$w" 2>/dev/null
exit 0
