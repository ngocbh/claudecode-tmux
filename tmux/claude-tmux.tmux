# claude-tmux — prepend the Claude Code state chip to status-right (idempotent).
# Generated by install.sh into ~/.config/claude-tmux/ and sourced from
# ~/.tmux.conf.

set -g status-interval 1
set -g status-right-length 200

# Read the current status-right and prepend our chip, embedding the original
# directly so its formats still expand. The chip's leading '#' is built at
# runtime (printf '\043') because tmux expands #(...) / #{...} found inside a
# run-shell argument — a literal would execute here instead of being stored.
# Idempotent: skip if already prepended; and any `set -g status-right` earlier in
# ~/.tmux.conf resets it before we run, so reloads never stack.
# Want the chip on the RIGHT instead? use "$cur${h}(@STATUS_CMD@)".
run-shell -b 'h=$(printf "\043"); cur=$(tmux show -gv status-right); case "$cur" in *claude-tmux-status*) exit 0 ;; esac; tmux set -g status-right "${h}(@STATUS_CMD@)$cur"'
