# claude-tmux config (Claude Code + Codex CLI) — copy to
# ~/.config/claude-tmux/config and uncomment to override. Values are sourced by
# the scripts as POSIX sh, so use shell syntax.
# Colors are tmux style strings (see `man tmux` -> STYLES); colourNNN or #rrggbb.

# --- status-right chips (shown for sessions you're NOT currently viewing) ----
# CT_RUN_CHIP='fg=colour016,bg=#ffa500,bold'   # working   (black on amber)
# CT_ASK_CHIP='fg=colour016,bg=#f7768e,bold'   # needs you (black on red)
# CT_IDLE_CHIP='fg=colour016'                   # idle/done (black text, no fill)
# CT_SEP='#[fg=colour240]│#[default]'           # separator after the chips
# CT_ICON_RUN='●'
# CT_ICON_ASK='?'
# CT_ICON_IDLE='✓'

# --- window-tab tint (shown on selected and inactive tracked tabs) -----------
# CT_RUN_TAB='fg=#1a1b26,bg=#ff9e64,bold'       # working
# CT_ASK_TAB='fg=#1a1b26,bg=#f7768e,bold'       # needs you

# --- clickable chips (tmux 3.2+) ---------------------------------------------
# Make the status-right chips clickable: left-click a chip to switch to that
# session and select its window. Accepts 1/true/yes/on. Enabling this turns ON
# tmux mouse mode (`set -g mouse on`), which changes terminal text selection
# (hold Shift to select/copy text, scroll enters copy-mode). Reload tmux after
# changing (`tmux source-file ~/.tmux.conf`). Off by default.
# CT_CLICKABLE=1
